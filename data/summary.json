    "compact": {
      "rules": {
        "title": "X 怎么挑帖子",
        "conclusion": "不是点赞多就排前面。X 先找帖子，再猜你会不会点开、回复、分享或继续看，最后过滤和调整顺序。",
        "sections": [
          {
            "title": "从哪找",
            "conclusion": "既看你关注的人，也看没关注的人和热门帖子。"
          },
          {
            "title": "怎么排",
            "conclusion": "猜你可能做什么，再按不同动作的权重算分；同一作者刷屏还会被压一压。"
          },
          {
            "title": "哪些会被踢掉",
            "conclusion": "已看过、屏蔽或静音的内容，以及不符合展示规则的帖子。"
          }
        ]
      },
      "weights": {
        "title": "权重该怎么看",
        "conclusion": "数字表示预测信号的权重，不是一次真实互动直接增加或减少的分数。",
        "sections": [
          {
            "title": "互动信号",
            "conclusion": "回复、复制链接分享与关注作者各有单独的预测权重。",
            "weight_names": [
              "ReplyWeight",
              "ShareViaCopyLinkWeight",
              "FollowAuthorWeight"
            ]
          },
          {
            "title": "常见互动比较",
