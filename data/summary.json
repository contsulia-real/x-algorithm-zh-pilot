            "weight_names": [
              "FavoriteWeight",
              "RetweetWeight",
              "QuoteWeight"
            ]
          },
          {
            "title": "负反馈信号",
            "conclusion": "静音、屏蔽和举报是负向预测信号，不能直接换算成点赞次数。",
            "weight_names": [
