  "presentation": {
    "full": {
      "rules": {
        "title": "X 为什么给你推这些帖子",
        "conclusion": "「为你推荐」不是点赞排行榜。X 会从你关注和没关注的账号里找帖子，估算你会对哪些帖子感兴趣，再排序和筛选。",
        "sections": [
          {
            "title": "帖子从哪来",
            "conclusion": "不只是你关注的人。没关注的账号和近期热门帖子，也可能出现在推荐里。",
            "detail": "Thunder 提供关注账号最近发的帖子，Phoenix、SimClusters 和热门帖子源补充其他内容。找到了只是进入候选名单，不代表一定会出现在首页。"
          },
          {
            "title": "怎样决定谁排前面",
            "conclusion": "X 主要猜的是你会不会点赞、回复、分享、点开或者继续看，而不是直接按帖子已有的点赞数排。",
            "detail": "模型为不同的行为算出预测值，再乘上各自的权重，加起来作为排序依据。点“不感兴趣”、屏蔽等负面反应也会被预测进去。"
          },
          {
            "title": "为什么算完分还会换顺序",
            "conclusion": "X 不想让同一个作者一直刷屏，也会调整没关注的账号和曝光较少的作者的排序。",
            "detail": "公开代码里有作者多样性衰减、关注外内容折扣和新作者提升；VMRanker 还会进一步减少相邻帖子内容过于相似的情况。所以不是分数最高的一定排第一。"
          },
          {
            "title": "为什么有的帖子根本看不到",
            "conclusion": "看过的帖子、被屏蔽的账号、命中静音关键词的内容，可能在排序前就被排除。",
            "detail": "默认过滤还包括去重、超过 48 小时的旧帖、订阅限制等。排序之后也有可见性检查，某些带限制标签的内容不能直接展示。"
          },
          {
            "title": "这些规则能说明什么",
            "conclusion": "能帮助你理解公开的推荐流程，但不能据此算出一条帖子能拿到多少曝光。",
            "detail": "这不是完整的线上配置。官方没公开部分 Grox 提示文件和 botmaker 规则，公开代码里的默认权重也可能被线上实验覆盖。"
          }
        ]
      },
      "weights": {
        "title": "X 给哪些行为算权重",
        "conclusion": "这些数字不是「点一次赞加 0.66 分」。X 先估算用户做某个动作的可能性，再拿预测结果乘权重。光看数字，算不出实际推荐量。",
        "sections": [
          {
            "title": "点赞、回复、转发、分享",
            "conclusion": "回复默认是 5，普通转发是 1，复制链接分享是 20。但这不表示复制一次链接就抵 20 次转发。",
            "detail": "每个数字都要乘上对应行为的预测概率。X 还单独给互相关注用户的回复设置了加成；该加成不是对所有回复无条件生效。",
            "weight_names": [
              "FavoriteWeight",
              "ReplyWeight",
              "RetweetWeight",
              "QuoteWeight",
              "ShareWeight",
              "ShareViaDmWeight",
              "ShareViaCopyLinkWeight",
              "FollowAuthorWeight",
              "BidirectionalFollowReplyWeightBoost"
            ]
          },
          {
            "title": "点击、看视频、停留",
            "conclusion": "有人会不会点开帖子、看视频、打开链接，以及停留多久，也会影响模型打分。",
            "detail": "「点开」「停留」「点开后继续停留」是不同的预测项目。有些项目的默认权重很小，但不能直接据此判断它们在真实推荐中有多重要。",
            "weight_names": [
              "PhotoExpandWeight",
              "VideoOpenWeight",
              "ClickWeight",
              "OpenLinkWeight",
              "ProfileClickWeight",
              "VqvWeight",
              "DwellWeight",
              "QuotedClickWeight",
              "QuotedVqvWeight",
              "PostUnexploredWeight",
              "ContDwellTimeWeight",
              "ContClickDwellTimeWeight",
              "VideoCarouselVideoOpenWeight"
            ]
          },
          {
            "title": "不感兴趣、屏蔽、静音、举报",
            "conclusion": "这些项目的默认权重是负数。举报是 -234，但不是说举报一次就能抵掉几百次点赞。",
            "detail": "模型要先估算不同用户采取这些动作的概率。负数影响的是预测后的分数，不能直接按实际互动次数相减。",
            "weight_names": [
              "NotInterestedWeight",
              "BlockAuthorWeight",
              "MuteAuthorWeight",
              "ReportWeight",
              "NotDwelledWeight"
            ]
          },
          {
            "title": "为什么有的权重是 0",
            "conclusion": "这里的 0 只代表公开代码给出的默认值，不等于 X 永远不用这些行为。",
            "detail": "实际线上可能启用不同的实验或配置。想比较权重，先看它预测的是什么，不能只比两个数字的大小。",
            "weight_names": [
              "BidirectionalFollowDwellWeightBoost",
              "ReactWithVideoWeight",
              "VideoCarouselImmersiveVqvWeight"
            ]
          }
        ]
      },
      "updates": {
        "title": "最近改了什么",
        "conclusion": "这份更新记录目前只有一次初始整理。它是以后对比改动的起点，不是说 X 刚推出了一套新算法。",
        "sections": [
          {
            "title": "当前记录的是哪一版",
            "conclusion": "基线对应官方提交 6258a154，整理了 README、权重参数和评分代码。",
            "detail": "这是第一次把公开内容整理成中文。接下来才会根据官方源码的真实变化写更新记录。"
          },
          {
            "title": "官方以前说明过什么",
            "conclusion": "2026 年 8 月，官方澄清过权重的用法：乘的是预测值，不是实际互动次数。",
            "detail": "官方也更新过推荐来源、过滤规则的说明。9 月的 Under the Hood 报告进一步增加了法律限制标签等信息；这些都属于此前的公告。"
          },
          {
            "title": "以后怎么看变化",
            "conclusion": "相关源码真的改了，才会新增一条记录；权重改了会列出改前、改后的数字。",
            "detail": "目前只跟踪 README、参数文件和评分代码。官方仓库里其他文件的改动，不会自动被写成推荐算法的变化。"
          }
        ]
      }
    },
