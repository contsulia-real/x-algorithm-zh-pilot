  "presentation": {
    "full": {
      "rules": {
        "title": "X 为什么给你推这些帖子",
        "conclusion": "「为你推荐」不是点赞排行榜。X 会从你关注和没关注的账号里找帖子，估算你会对哪些帖子感兴趣，再排序和筛选。",
        "sections": [
          {
            "title": "帖子从哪来",
            "conclusion": "不只是你关注的人。没关注的账号和近期热门帖子，也可能出现在推荐里。",
            "detail": "Thunder 提供关注账号最近发的帖子，Phoenix、SimClusters 和热门帖子源补充其他内容。找到了只是进入候选名单，不代表一定会出现在首页。"
          },
          {
            "title": "怎样决定谁排前面",
            "conclusion": "X 主要猜的是你会不会点赞、回复、分享、点开或者继续看，而不是直接按帖子已有的点赞数排。",
            "detail": "模型为不同的行为算出预测值，再乘上各自的权重，加起来作为排序依据。点“不感兴趣”、屏蔽等负面反应也会被预测进去。"
          },
          {
            "title": "为什么算完分还会换顺序",
            "conclusion": "X 不想让同一个作者一直刷屏，也会调整没关注的账号和曝光较少的作者的排序。",
            "detail": "公开代码里有作者多样性衰减、关注外内容折扣和新作者提升；VMRanker 还会进一步减少相邻帖子内容过于相似的情况。所以不是分数最高的一定排第一。"
          },
          {
            "title": "为什么有的帖子根本看不到",
            "conclusion": "看过的帖子、被屏蔽的账号、命中静音关键词的内容，可能在排序前就被排除。",
            "detail": "默认过滤还包括去重、超过 48 小时的旧帖、订阅限制等。排序之后也有可见性检查，某些带限制标签的内容不能直接展示。"
          },
          {
            "title": "这些规则能说明什么",
            "conclusion": "能帮助你理解公开的推荐流程，但不能据此算出一条帖子能拿到多少曝光。",
            "detail": "这不是完整的线上配置。官方没公开部分 Grox 提示文件和 botmaker 规则，公开代码里的默认权重也可能被线上实验覆盖。"
          }
        ]
      },
      "weights": {
        "title": "预测行为与默认权重",
        "conclusion": "权重乘的是模型预测的概率或连续值，而不是已经发生的行为次数。它们用于合成分数，不能推断“举报一次抵多少次点赞”。",
        "sections": [
          {
            "title": "互动与关注",
            "conclusion": "这些是预测用户可能采取的正向互动，不是已经获得的互动数量。",
            "detail": "回复、分享方式与关注动作分别具有不同的公开默认权重；互关回复的加成也是独立参数，不能理解为每条回复都直接获得固定加分。",
            "weight_names": [
              "FavoriteWeight",
              "ReplyWeight",
              "RetweetWeight",
              "QuoteWeight",
              "ShareWeight",
              "ShareViaDmWeight",
              "ShareViaCopyLinkWeight",
              "FollowAuthorWeight",
              "BidirectionalFollowReplyWeightBoost"
            ]
          },
          {
            "title": "点击与观看行为",
            "conclusion": "系统也预测用户是否打开、观看及停留；不只看点赞和转发。",
            "detail": "这组包含图片展开、视频观看、点击链接与不同停留时间的模型输出，部分默认权重为 0。",
            "weight_names": [
              "PhotoExpandWeight",
              "VideoOpenWeight",
              "ClickWeight",
              "OpenLinkWeight",
              "ProfileClickWeight",
              "VqvWeight",
              "DwellWeight",
              "QuotedClickWeight",
              "QuotedVqvWeight",
              "PostUnexploredWeight",
              "ContDwellTimeWeight",
              "ContClickDwellTimeWeight",
              "VideoCarouselVideoOpenWeight"
            ]
          },
          {
            "title": "负反馈与不感兴趣",
            "conclusion": "不感兴趣、屏蔽、静音与举报有独立的负向权重。",
            "detail": "负值代表它们的预测概率对合成评分的方向，而不是发生一次后直接扣去相应分数；也不能仅凭数值大小比较真实发生频率。",
            "weight_names": [
              "NotInterestedWeight",
              "BlockAuthorWeight",
              "MuteAuthorWeight",
              "ReportWeight",
              "NotDwelledWeight"
            ]
          },
          {
            "title": "当前默认值为零的参数",
            "conclusion": "默认值为 0 的项在这个公开配置下不直接贡献对应加权项。",
            "detail": "它们不代表系统永远不会使用相关行为，线上实验或特性开关可能覆盖默认配置。",
            "weight_names": [
              "BidirectionalFollowDwellWeightBoost",
              "ReactWithVideoWeight",
              "VideoCarouselImmersiveVqvWeight"
            ]
          }
        ]
      },
