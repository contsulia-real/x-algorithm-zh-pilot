  "presentation": {
    "full": {
      "rules": {
        "title": "For You 推荐",
        "conclusion": "每次刷新推荐页，系统都会从关注内外收集帖子，经过过滤、预测打分和排序调整后生成列表。公开代码给出了这些步骤的实现。",
        "sections": [
          {
            "title": "候选来源",
            "conclusion": "Thunder 提供已关注账号的近期帖子；Phoenix、SimClusters 和热门来源补充其他内容。",
            "detail": "公开参数为各来源设置了候选数量和时间限制，例如 Thunder 最多 1200 条，Phoenix 最多 1000 条。这些是默认上限，不是每次实际取到的数量。"
          },
          {
            "title": "排序前过滤",
            "conclusion": "去重、已经看过或展示过的帖子、屏蔽与静音条件会影响哪些内容进入排序。",
            "detail": "公开过滤规则还涉及旧帖、本人帖子、静音关键词、订阅资格及特定地区的限制。帖子被召回，并不等于有资格进入最终列表。"
          },
          {
            "title": "预测和打分",
            "conclusion": "Phoenix 预测观看者点赞、回复、分享、点开或停留等行为的可能性；RankingScorer 按各项权重合成分数。",
            "detail": "多数权重作用于预测概率，部分作用于预测的连续数值。已有互动次数不直接等于这一环节的得分。"
          },
          {
            "title": "排序调整",
            "conclusion": "初次打分后，作者多样性、关注外内容折扣、新作者提升等规则还会影响位置。",
            "detail": "VMRanker 也会进一步重排。连续出现同一作者、内容过于相似等情况，不能只用初次打分解释。"
          },
          {
            "title": "可见性检查",
            "conclusion": "排到前面的帖子仍可能因可见性检查而无法展示。",
            "detail": "公开过滤代码包含 ALLOW、NOTICE、INTERSTITIAL、DROP 等结果。被标为 DROP 的帖子会被移除，相关父帖或引用关系也可能受到影响。"
          },
          {
            "title": "适用范围",
            "conclusion": "这里描述的是已公开的实现和默认参数，不是所有账号当前采用的完整配置。",
            "detail": "部分 Grox 提示文件和 botmaker 规则尚未公开；线上实验及特性开关也可能改变默认设置。"
          }
        ]
      },
      "weights": {
        "title": "默认权重",
        "conclusion": "下列数值来自公开参数文件，共 30 项。每项权重都用于相应的模型预测结果，不能直接换算成一次点赞、回复或举报的固定分数。",
        "sections": [
          {
            "title": "互动与关注",
            "conclusion": "点赞、回复、转发、引用及不同分享方式分别计权。复制链接分享的默认权重是 20，点赞为 0.66。",
            "detail": "二者对应不同的预测概率。数值相除不能得到真实互动效果的倍数；互相关注回复加成也有独立的适用条件。",
            "weight_names": [
              "FavoriteWeight",
              "ReplyWeight",
              "RetweetWeight",
              "QuoteWeight",
              "ShareWeight",
              "ShareViaDmWeight",
              "ShareViaCopyLinkWeight",
              "FollowAuthorWeight",
              "BidirectionalFollowReplyWeightBoost"
            ]
          },
          {
            "title": "点击与停留",
            "conclusion": "点开帖子、打开链接、观看视频和停留时长使用不同参数。",
            "detail": "例如打开帖子为 0.3，打开链接为 0.2，点击后连续停留时长为 0.4。它们针对不同预测结果，并非相同单位的互动计数。",
            "weight_names": [
              "PhotoExpandWeight",
              "VideoOpenWeight",
              "ClickWeight",
              "OpenLinkWeight",
              "DwellWeight",
              "QuotedClickWeight",
              "PostUnexploredWeight",
              "ContDwellTimeWeight",
              "ContClickDwellTimeWeight",
              "VideoCarouselVideoOpenWeight"
            ]
          },
          {
            "title": "负面反馈",
            "conclusion": "不感兴趣、屏蔽、静音、举报及未停留使用负权重。举报的默认值为 -234。",
            "detail": "这些负值参与预测后的评分计算，不代表一条实际举报会直接扣除 234 分。",
            "weight_names": [
              "NotInterestedWeight",
              "BlockAuthorWeight",
              "MuteAuthorWeight",
              "ReportWeight",
              "NotDwelledWeight"
            ]
          },
          {
            "title": "默认值为零",
            "conclusion": "公开参数中有 6 项默认权重为 0，包括部分视频观看及个人资料点击相关项目。",
            "detail": "零值表示这些项目在本组默认参数下不贡献对应加权项，不足以证明线上所有实验都不使用它们。",
            "weight_names": [
              "BidirectionalFollowDwellWeightBoost",
              "ProfileClickWeight",
              "VqvWeight",
              "QuotedVqvWeight",
              "ReactWithVideoWeight",
              "VideoCarouselImmersiveVqvWeight"
            ]
          }
        ]
      },
